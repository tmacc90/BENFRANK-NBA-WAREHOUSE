FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY benfrank_logs.py auto_server.py screenshot_intake.py player_registry.py source_verification.py nba_team_boxscores.py free_source_network.py ./
RUN pip install --no-cache-dir 'Pillow>=10,<12'
ENV BENFRANK_HOST=0.0.0.0 PORT=10000 BENFRANK_DATA_DIR=/tmp/benfrank_runs
CMD ["python","auto_server.py"]
