FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr poppler-utils && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements.txt ./requirements.txt
COPY mobile/requirements.txt ./mobile/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY . /app
RUN mkdir -p /var/lib/benfrank && chmod 700 /var/lib/benfrank
ENV BENFRANK_MOBILE_RUNS=/var/lib/benfrank/jobs
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn mobile.api:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
